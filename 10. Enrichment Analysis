##To analyse the enrichment of our peaks against a certain genomics feature, e.g. histone mark, enricnment analysis could be performed

##Convert BAM file to BIGWIG

#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=250:mem=900gb

eval "$(/rds/general/user/nfa23/home/anaconda3/bin/conda shell.bash hook)"
cd $PBS_O_WORKDIR

bamCoverage -b FILE_NAME.bam -o FILE_NAME.bigwig --binSize 10 --normalizeUsing CPM

## Generate enrichment matrix

#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=250:mem=900gb

eval "$(~/anaconda3/bin/conda shell.bash hook)"
conda activate deeptools_env

cd $PBS_O_WORKDIR

computeMatrix reference-point --referencePoint center -b 2000 -a 2000 -R REFERENCE_PEAKS.bed -S FILE_NAME.bigwig --skipZeros -o FILE_NAME_matrix.mat.gz -p 250

# REFERENCE_PEAKS.bed is a BED file containing the information of genomic feature you want to enrich your peaks around. e.g. a histone modification. Typically, this is found in online repositories
# FILE_NAME.bigwig is the BIGWIG file of your peaks

## Plot Enrichment Profile in deeptools_env
eval "$(~/anaconda3/bin/conda shell.bash hook)"
conda activate deeptools_env 

plotProfile -m FILE_NAME_matrix.mat.gz -out FILE_NAME_PROFILE.png --plotTitle --outRawCounts

## Plot Enrichment Heatmap in deeptools_env
eval "$(~/anaconda3/bin/conda shell.bash hook)"
conda activate deeptools_env

plotHeatmap -m FILE_NAME_matrix.mat.gz -out FILE_NAME_PROFILE.png
