##Correlation analysis can be performed to investigate if there is a strong correlation between biological replicates. This can be performed on R-studio after pretreatment of the BAM files.

##Convert BAM to BED file
#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=250:mem=900gb

module load bedtools
for file in "$PBS_O_WORKDIR"/*.bam
do
name=$(basename "$file" .bam) 
bedtools bamtobed -i "$file" -bedpe > "$PBS_O_WORKDIR/${name}.bed"
done

##Keep the read pairs that are on the same chromosome and fragment length less than 1000bp.
#PBS -lwalltime=08:00:00
#PBS -lselect=1:ncpus=250:mem=900gb

for file in "$PBS_O_WORKDIR"/*.bed
do
name=$(basename "$file" .bed) 
awk '$1 == $4 && $6 - $2 < 1000 {print $0}' "$file" > "$PBS_O_WORKDIR/${name}.clean.bed"
done

## Only extract the fragment related columns
cut -f 1,2,6 FILE_NAME.clean.bed | sort -k1,1 -k2,2n -k3,3n  > FILE_NAME.fragments.bed

##Use the mid point of each fragment to infer which 500bp bins does this fragment belong to.
binLen=500 #Click enter directly on terminal
awk -v w=$binLen '($2 + $3 > 0) {print $1, int(($2 + $3)/(2*w))*w + w/2}' FILE_NAME.fragments.bed | sort -k1,1V -k2,2n | uniq -c | awk -v OFS="\t" '{print $2, $3, $1}' | sort -k1,1V -k2,2n > FILE_NAME.fragmentsCount.bin$binLen.bed

