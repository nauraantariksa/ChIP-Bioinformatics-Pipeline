#All peak intersection is done directly on Terminal. Remember to be in the directory where you want to keep the output file to ensure the file is written there. Otherwise, indicate the full file path.

#Intersecting 3x repeats; peaks will be called if present in 2 or more samples
module load bedtools
bedtools intersect -u -a FILE_NAME_Bio1.narrowPeak -b FILE_NAME_Bio2.narrowPeak -b FILE_NAME_Bio3.narrowPeak > FILE_NAME_shared_peaks_1v23.narrowPeak

#Intersecting 3x repeats; peaks called if in all 3 samples
module load bedtools
bedtools intersect -u -a FILE_NAME_Bio1.narrowPeak -b FILE_NAME_Bio2.narrowPeak > FILE_NAME_shared_peaks_12.narrowPeak
bedtools intersect -u -a FILE_NAME_shared_peaks_12.narrowPeak -b FILE_NAME_Bio3.narrowPeak > FILE_NAME_shared_peaks123.narrowPeak

