#Creating a job

vim name.pbs
#type 'i' to allow edits
#type 'Esc' to finish editing
#type ':wq' to quit pbs

#Submitting a job
qsub name.pbs

#Monitoring a job
qstat

#Deleting a job
qdel followed by job id to delete job from queue

